# Local launch backend
SPORTS_TERMINAL_DB_PATH=backend/.data/sports_terminal.db
SPORTS_TERMINAL_CORS_ORIGINS=http://localhost:5000,http://localhost:8000,http://127.0.0.1:5000,http://127.0.0.1:8000
SPORTS_TERMINAL_NBA_RELEASE_ROOT=assets/data/nba/terminal_seed
SPORTS_TERMINAL_LOG_LEVEL=INFO

# Staging/public security controls
SPORTS_TERMINAL_ENFORCE_AUTH=false
SPORTS_TERMINAL_RATE_LIMITS=false
SPORTS_TERMINAL_AUTH_REQUESTS_PER_MINUTE=12
SPORTS_TERMINAL_API_REQUESTS_PER_MINUTE=120
SPORTS_TERMINAL_DATA_REQUESTS_PER_MINUTE=240
SPORTS_TERMINAL_HSTS=false
SPORTS_TERMINAL_REQUIRE_EMAIL_VERIFICATION=false

# External launch integrations. These values are intentionally not fabricated by the repository.
SPORTS_TERMINAL_AUTH_PROVIDER=
SPORTS_TERMINAL_EMAIL_PROVIDER=
SPORTS_TERMINAL_MFA_PROVIDER=
DATABASE_URL=
SPORTS_TERMINAL_PAYMENT_PROVIDER=
SPORTS_TERMINAL_DATA_RIGHTS_APPROVED=false
SPORTS_TERMINAL_PUBLIC_COMMUNITY=false
