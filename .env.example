# Local launch backend
SPORTS_TERMINAL_DB_PATH=backend/.data/sports_terminal.db
SPORTS_TERMINAL_CORS_ORIGINS=http://localhost:5000,http://localhost:8000,http://127.0.0.1:5000,http://127.0.0.1:8000

# External launch integrations. These values are intentionally not fabricated by the repository.
SPORTS_TERMINAL_AUTH_PROVIDER=
DATABASE_URL=
SPORTS_TERMINAL_PAYMENT_PROVIDER=
SPORTS_TERMINAL_DATA_RIGHTS_APPROVED=false
SPORTS_TERMINAL_PUBLIC_COMMUNITY=false
