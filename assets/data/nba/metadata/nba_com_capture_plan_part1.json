{
  "version": 1,
  "contract": "sports-terminal-nba-com-capture-plan-v1",
  "source_capture": "NBA Stats Scrape Part 1",
  "season_range": {
    "from": "1946-47",
    "to": "2025-26",
    "order": "newest-first"
  },
  "season_types": [
    "Regular Season",
    "Playoffs"
  ],
  "principles": [
    "Attempt every configured surface/variant for every NBA season from 2025-26 back through 1946-47; availability is discovered from the response rather than assumed from a hard-coded first season.",
    "Regular Season and Playoffs are separate immutable scopes.",
    "Raw responses, normalized tables, request parameters, schemas, row counts, source hashes and validation status are persisted locally before static materialization.",
    "User-supplied row ceilings are sanity bounds, not expected row counts.",
    "Empty historical responses are recorded as unavailable/empty and are not fabricated.",
    "Sports Terminal browser/runtime never calls stats.nba.com; collection is a one-time/local acquisition step and the website reads generated static files."
  ],
