migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code, so it is intentionally not ignored by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Python ingestion environments and HTTP caches
.venv/
.historical-venv/
.nba-api-venv/
.cache/
__pycache__/

# Local source exports and generated import review files
/raw/*.json
/raw/basketball_reference/
/raw/historical/
!/raw/README.md

# NBA.com Stats endpoint-discovery and authorized local landing data.
# HAR files can contain browser/session material and must never be committed.
/raw/nba_com_stats/**
!/raw/nba_com_stats/README.md
*.har
/artifacts/nba_com_stats_endpoint_inventory.json
/artifacts/nba_com_stats_endpoint_inventory.md

# Generated NBA API schema coverage reports
/artifacts/nba_api_metric_coverage.json
/artifacts/nba_api_metric_coverage.md

# Large generated historical warehouses and reports
/data/warehouse/nba_history.sqlite
/data/warehouse/nba_history.sqlite-shm
/data/warehouse/nba_history.sqlite-wal
/data/warehouse/nba_history_import_report.json
/data/warehouse/nba_canonical_build_report.json

# Generated immutable website corpus. Built locally from nba_history.sqlite by
# tools/build_static_nba_website_data.py before Flutter starts.
/web/data/nba_static/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
