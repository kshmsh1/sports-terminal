# Sports Terminal production template. COPY LOCALLY; never commit real secrets.
SPORTS_TERMINAL_ENV=production
SPORTS_TERMINAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sports_terminal
SPORTS_TERMINAL_AUTO_MIGRATE=false
SPORTS_TERMINAL_DATABASE_POOL_SIZE=8

SPORTS_TERMINAL_CORS_ORIGINS=https://YOUR_FRONTEND_HOST
SPORTS_TERMINAL_ALLOWED_HOSTS=YOUR_API_HOST
SPORTS_TERMINAL_TRUST_PROXY_HEADERS=false

# Generate independent high-entropy values for every secret below.
SPORTS_TERMINAL_SESSION_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SPORTS_TERMINAL_MFA_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SPORTS_TERMINAL_RELEASE_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SPORTS_TERMINAL_BACKUP_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

SPORTS_TERMINAL_ENFORCE_AUTH=true
SPORTS_TERMINAL_RATE_LIMITS=true
SPORTS_TERMINAL_RATE_LIMIT_BACKEND=database
SPORTS_TERMINAL_HSTS=true

# Provider-neutral billing remains off until a real provider and webhook secret are configured.
SPORTS_TERMINAL_BILLING_MODE=disabled
SPORTS_TERMINAL_BILLING_WEBHOOK_SECRET=

SPORTS_TERMINAL_LOG_LEVEL=INFO
PORT=8000
WEB_CONCURRENCY=2
